{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "_comment": "Since app will run in docker, this is not needed. In case someone wants to run it locally, this should be updated accordingly",
    "DefaultConnection": "Host=localhost;Database=RPSSLGame;Username=postgres;Password=postgres"
  },
  "RandomNumberService": {
    "Url": "https://codechallenge.boohma.com/random"
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://codechallenge.boohma.com"
  ],
  "Cors": {
    "PolicyName": "CorsPolicy"
  },
  "RateLimiting": {
    "PolicyName": "FixedPolicy",
    "PermitLimit": 10,
    "WindowSeconds": 10,
    "QueueLimit": 2
  }
}
