{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RandomNumberService": {
    "Url": "https://codechallenge.boohma.com/random"
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://codechallenge.boohma.com"
  ],
  "Cors": {
    "PolicyName": "CorsPolicy"
  },
  "RateLimiting": {
    "PolicyName": "FixedPolicy",
    "PermitLimit": 10,
    "WindowSeconds": 10,
    "QueueLimit": 2
  }
}
